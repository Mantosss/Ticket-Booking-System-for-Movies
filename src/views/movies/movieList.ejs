
<%- include("../common/header", { title: "Available Movies" }) %>

<%- include("../common/navbar") %>

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Now Showing</h2>
            <p class="text-muted">Explore and book your favourite movies.</p>
        </div>
    </div>

    <% if (typeof errorMessage !== "undefined" && errorMessage.length) { %>
        <div class="alert alert-danger">
            <%= errorMessage[0] %>
        </div>
    <% } %>

    <% if (!movies || movies.length === 0) { %>

        <div class="card shadow-sm p-5 text-center">
            <h4>No Movies Available</h4>
            <p class="text-muted">
                Currently, there are no movies available.
                Please check again later.
            </p>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% movies.forEach(movie => { %>

                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card h-100 shadow-sm">

                        <% if (movie.poster) { %>
                            <img
                                src="<%= movie.poster %>"
                                class="card-img-top"
                                alt="<%= movie.name %>"
                                style="height: 280px; object-fit: cover;"
                            >
                        <% } else { %>
                            <div
                                class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                style="height: 280px;"
                            >
                                No Poster Available
                            </div>
                        <% } %>

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                <%= movie.name %>
                            </h5>

                            <p class="text-muted mb-2">
                                <strong>Genre:</strong>
                                <%= movie.genre && movie.genre.length
                                    ? movie.genre.join(", ")
                                    : "N/A" %>
                            </p>

                            <p class="text-muted mb-2">
                                <strong>Language:</strong>
                                <%= movie.language || "N/A" %>
                            </p>

                            <p class="text-muted mb-3">
                                <strong>Duration:</strong>
                                <%= movie.duration %> minutes
                            </p>

                            <a
                                href="/movies/details/<%= movie._id %>"
                                class="btn btn-primary mt-auto"
                            >
                                View Details & Book
                            </a>

                        </div>
                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

<%- include("../common/footer") %>

