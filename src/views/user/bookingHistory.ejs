
<%- include("../common/header", { title: "My Booking History" }) %>

<%- include("../common/navbar") %>

<div class="container mt-5 mb-5">

    <h2 class="mb-4">My Booking History</h2>

    <% if (typeof errorMessage !== "undefined" && errorMessage.length) { %>
        <div class="alert alert-danger">
            <%= errorMessage[0] %>
        </div>
    <% } %>

    <% if (!bookings || bookings.length === 0) { %>

        <div class="card shadow-sm p-5 text-center">
            <h4>No Bookings Found</h4>
            <p class="text-muted">
                You haven't booked any movie tickets yet.
            </p>
            <a href="/movies" class="btn btn-primary">
                Explore Movies
            </a>
        </div>

    <% } else { %>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Movie</th>
                        <th>Theater</th>
                        <th>Show Date & Time</th>
                        <th>Tickets</th>
                        <th>Booking Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% bookings.forEach(booking => { %>

                        <tr>
                            <td>
                                <%= booking.movie ? booking.movie.name : "N/A" %>
                            </td>

                            <td>
                                <%= booking.theater ? booking.theater.name : "N/A" %>
                            </td>

                            <td>
                                <%= booking.show && booking.show.showDateTime
                                    ? new Date(booking.show.showDateTime).toLocaleString()
                                    : "N/A" %>
                            </td>

                            <td>
                                <%= booking.ticketCount %>
                            </td>

                            <td>
                                <%= new Date(booking.bookingDate).toLocaleDateString() %>
                            </td>

                            <td>
                                <% if (booking.status === "Confirmed") { %>
                                    <span class="badge bg-success">Confirmed</span>
                                <% } else { %>
                                    <span class="badge bg-danger">Cancelled</span>
                                <% } %>
                            </td>

                            <td>
                                <a
                                    href="/bookings/details/<%= booking._id %>"
                                    class="btn btn-sm btn-info"
                                >
                                    Details
                                </a>

                                <% if (booking.status === "Confirmed") { %>
                                    <form
                                        action="/bookings/cancel/<%= booking._id %>"
                                        method="POST"
                                        class="d-inline"
                                        onsubmit="return confirm('Are you sure you want to cancel this booking?');"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-danger"
                                        >
                                            Cancel
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>

                    <% }) %>
                </tbody>

            </table>
        </div>

    <% } %>

</div>

<%- include("../common/footer") %>
