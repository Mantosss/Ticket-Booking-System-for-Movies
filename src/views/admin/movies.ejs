
<%- include("../common/header", { title: "Manage Movies" }) %>

<%- include("../common/navbar") %>

<div class="container-fluid mt-4 mb-5">

    <div class="row">

        <!-- Admin Sidebar -->
        <div class="col-md-3 col-lg-2 mb-4">
            <%- include("../common/sidebar") %>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10">

            <h2 class="mb-4">Manage Movies</h2>

            <!-- Flash Messages -->
            <% if (typeof successMessage !== "undefined" && successMessage.length) { %>
                <div class="alert alert-success">
                    <%= successMessage[0] %>
                </div>
            <% } %>

            <% if (typeof errorMessage !== "undefined" && errorMessage.length) { %>
                <div class="alert alert-danger">
                    <%= errorMessage[0] %>
                </div>
            <% } %>

            <!-- Add Movie Form -->
            <div class="card shadow-sm mb-5">

                <div class="card-header">
                    <h5 class="mb-0">Add New Movie</h5>
                </div>

                <div class="card-body">

                    <form action="/movies/admin/add" method="POST">

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Movie Name</label>
                                <input type="text" name="name"
                                       class="form-control" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Genre</label>
                                <input type="text" name="genre"
                                       class="form-control"
                                       placeholder="Action, Drama, Comedy"
                                       required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Language</label>
                                <input type="text" name="language"
                                       class="form-control" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Duration (Minutes)</label>
                                <input type="number" name="duration"
                                       class="form-control" min="1" required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cast</label>
                                <input type="text" name="cast"
                                       class="form-control"
                                       placeholder="Actor 1, Actor 2">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Director</label>
                                <input type="text" name="director"
                                       class="form-control">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Release Date</label>
                                <input type="date" name="releaseDate"
                                       class="form-control">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Poster URL</label>
                                <input type="url" name="poster"
                                       class="form-control"
                                       placeholder="https://example.com/poster.jpg">
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label">Description</label>
                                <textarea name="description"
                                          class="form-control"
                                          rows="3"></textarea>
                            </div>

                        </div>

                        <button type="submit" class="btn btn-success">
                            Add Movie
                        </button>

                    </form>

                </div>
            </div>

            <!-- Existing Movies -->
            <div class="card shadow-sm">

                <div class="card-header">
                    <h5 class="mb-0">All Movies</h5>
                </div>

                <div class="card-body table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Poster</th>
                                <th>Movie Name</th>
                                <th>Genre</th>
                                <th>Language</th>
                                <th>Duration</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (movies && movies.length > 0) { %>

                                <% movies.forEach(movie => { %>

                                    <tr>

                                        <td>
                                            <% if (movie.poster) { %>
                                                <img src="<%= movie.poster %>"
                                                     alt="Poster"
                                                     width="55"
                                                     height="70"
                                                     style="object-fit: cover;">
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </td>

                                        <td><%= movie.name %></td>

                                        <td>
                                            <%= movie.genre?.join(", ") || "N/A" %>
                                        </td>

                                        <td><%= movie.language %></td>

                                        <td><%= movie.duration %> min</td>

                                        <td>
                                            <a href="/movies/admin/update/<%= movie._id %>"
                                               class="btn btn-sm btn-warning mb-1">
                                                Edit
                                            </a>

                                            <form
                                                action="/movies/admin/delete/<%= movie._id %>"
                                                method="POST"
                                                class="d-inline"
                                                onsubmit="return confirm('Are you sure you want to delete this movie?');"
                                            >
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="6" class="text-center">
                                        No movies found.
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>
            </div>

        </div>

    </div>

</div>

<%- include("../common/footer") %>
